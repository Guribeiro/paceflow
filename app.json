{
  "expo": {
    "name": "PaceFlow",
    "slug": "paceflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gustavoribeiro.paceflow"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O PaceFlow usa a localização para medir distância e pace enquanto você grava uma corrida.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "WeekWidget",
              "displayName": "PaceFlow — Semana",
              "description": "Km da semana e pace do último treino",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            }
          ]
        }
      ]
    ],
    "scheme": "paceflow",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da3c5061-2fa8-42f8-9509-2223663ce3b0"
      }
    },
    "owner": "guribeirodeveloper"
  }
}
