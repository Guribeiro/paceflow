# Desenvolvimento ("PaceFlow Dev", npm run android:dev): copie para .env.local e
# preencha com a saída de `supabase status -o env` (API_URL e PUBLISHABLE_KEY).
# Sem essas variáveis o app funciona sem sync.
#
# Uso diário ("PaceFlow", npm run android:release): crie .env.production.local com
# a URL do projeto hospedado (https://<ref>.supabase.co) e a publishable key de
# `supabase projects api-keys`. Ele tem prioridade sobre .env.local no bundle de
# produção. Nunca use a secret/service_role key no app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
